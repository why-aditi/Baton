# Copy to scripts/.env.seed (git-ignored) and fill in. Never commit real tokens.
SEED_SITE=your-site.atlassian.net
# Meera's last day. Due dates in the story are relative to it.
SEED_LAST_DAY=2026-12-30
SEED_SPACE_KEY=NWP
SEED_BITBUCKET_WORKSPACE=your-workspace
# Only if your workspace requires a project for new repos (Premium workspaces do):
SEED_BITBUCKET_PROJECT=
SEED_ISSUE_TYPE=Task
# Real Jira keys for the story's PAY and PLAT projects. Codegeist demo sites already have a PLAT
# ("Platform Development"), so Northwind Pay's Platform project uses NWPLAT there.
SEED_PAY_KEY=PAY
SEED_PLAT_KEY=NWPLAT

# One Atlassian account per person. TOKEN is an API token from
# id.atlassian.com/manage-profile/security/api-tokens. BITBUCKET_TOKEN is only needed if
# that person's Jira/Confluence token can't call Bitbucket (see README).
SEED_MEERA_EMAIL=
SEED_MEERA_TOKEN=
SEED_MEERA_BITBUCKET_TOKEN=
SEED_ARJUN_EMAIL=
SEED_ARJUN_TOKEN=
SEED_ARJUN_BITBUCKET_TOKEN=
SEED_LIN_EMAIL=
SEED_LIN_TOKEN=
SEED_LIN_BITBUCKET_TOKEN=
SEED_PRIYA_EMAIL=
SEED_PRIYA_TOKEN=
SEED_PRIYA_BITBUCKET_TOKEN=
SEED_SAM_EMAIL=
SEED_SAM_TOKEN=
SEED_SAM_BITBUCKET_TOKEN=
SEED_DANA_EMAIL=
SEED_DANA_TOKEN=
SEED_DANA_BITBUCKET_TOKEN=
SEED_OMAR_EMAIL=
SEED_OMAR_TOKEN=
SEED_OMAR_BITBUCKET_TOKEN=
